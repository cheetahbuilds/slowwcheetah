---
layout: base.njk
---

{% if featured_image %}
  <img class="post-hero-img" src="{{ featured_image }}" alt="{{ title }}">
{% else %}
  <div class="post-hero-placeholder" style="background: linear-gradient(to bottom, var(--dusk), var(--forest));"></div>
{% endif %}

<article class="post-wrapper">

  <span class="entry-tag" style="margin-bottom: 20px; display: inline-block;">{{ category }}</span>

  <h1 style="font-family:'Playfair Display',serif; font-size:clamp(2.2rem,5vw,3.8rem); font-weight:900; line-height:1.1; color:var(--forest); margin: 16px 0 12px;">
    {{ title }}
  </h1>

  <p style="font-family:'Space Mono',monospace; font-size:0.65rem; letter-spacing:0.16em; text-transform:uppercase; color:rgba(90,90,74,0.6); margin-bottom: 36px;">
    {{ date | date("d MMMM yyyy") }}
  </p>

  {% if distance or duration or elevation or difficulty %}
  <div class="post-stats-bar">
    {% if distance %}
    <div class="post-stat"><strong>{{ distance }}</strong>Distance</div>
    {% endif %}
    {% if duration %}
    <div class="post-stat"><strong>{{ duration }}</strong>Duration</div>
    {% endif %}
    {% if elevation %}
    <div class="post-stat"><strong>{{ elevation }}</strong>Elevation</div>
    {% endif %}
    {% if difficulty %}
    <div class="post-stat"><strong>{{ difficulty }}</strong>Difficulty</div>
    {% endif %}
  </div>
  {% endif %}

  <div class="post-body">
    {{ content | safe }}
  </div>

  <a href="/journal/" class="post-back">← Back to Journal</a>

</article>
