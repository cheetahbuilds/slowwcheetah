<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ title if title else "Home" }} | Sloww Cheetah</title>
  <meta name="description" content="{{ description if description else settings.tagline }}">
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400;1,700&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />
  <style>
    /* ─── TOKENS ───────────────────────────────────────────────── */
    :root {
      --forest:   #1e3a26;
      --pine:     #2d5237;
      --sage:     #6b8f71;
      --khaki:    #c4a97d;
      --ember:    #d4712a;
      --ember-lt: #e8943f;
      --sky:      #3a6b8a;
      --dusk:     #0e1f14;
      --parchment:#f2ede4;
      --cream:    #faf7f2;
      --text-dark:#1a1a14;
      --text-mid: #5a5a4a;
    }

    /* ─── RESET ─────────────────────────────────────────────────── */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      font-family: 'Cormorant Garamond', Georgia, serif;
      background: var(--cream);
      color: var(--text-dark);
      overflow-x: hidden;
      cursor: default;
    }

    /* ─── CUSTOM CURSOR ─────────────────────────────────────────── */
    .cursor-dot {
      width: 8px; height: 8px;
      background: var(--ember);
      border-radius: 50%;
      position: fixed; top: 0; left: 0;
      pointer-events: none;
      z-index: 9999;
      transform: translate(-50%,-50%);
      transition: transform 0.1s ease;
    }
    .cursor-ring {
      width: 36px; height: 36px;
      border: 1.5px solid var(--khaki);
      border-radius: 50%;
      position: fixed; top: 0; left: 0;
      pointer-events: none;
      z-index: 9998;
      transform: translate(-50%,-50%);
      transition: transform 0.18s ease, opacity 0.3s;
      opacity: 0.6;
    }

    /* ─── NAV ────────────────────────────────────────────────────── */
    nav {
      position: fixed; top: 0; left: 0; right: 0;
      z-index: 100;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 22px 60px;
      transition: background 0.4s, padding 0.4s, backdrop-filter 0.4s;
    }
    nav.scrolled {
      background: rgba(14,31,20,0.92);
      backdrop-filter: blur(12px);
      padding: 14px 60px;
      border-bottom: 1px solid rgba(196,169,125,0.2);
    }
    .nav-logo {
      height: 50px;
      filter: drop-shadow(0 2px 8px rgba(0,0,0,0.4));
      transition: transform 0.3s;
    }
    .nav-logo:hover { transform: scale(1.06); }
    .nav-links { display: flex; gap: 40px; list-style: none; }
    .nav-links a {
      font-family: 'Space Mono', monospace;
      font-size: 0.72rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--parchment);
      text-decoration: none;
      position: relative;
      opacity: 0.85;
      transition: opacity 0.2s;
    }
    .nav-links a::after {
      content: '';
      position: absolute; bottom: -4px; left: 0;
      width: 0; height: 1.5px;
      background: var(--ember);
      transition: width 0.3s ease;
    }
    .nav-links a:hover { opacity: 1; }
    .nav-links a:hover::after { width: 100%; }

    /* ─── SECTION BASE ───────────────────────────────────────────── */
    section { position: relative; }
    .section-inner {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 60px;
    }
    .reveal {
      opacity: 0;
      transform: translateY(40px);
      transition: opacity 0.9s ease, transform 0.9s ease;
    }
    .reveal.visible { opacity: 1; transform: translateY(0); }
    .reveal-delay-1 { transition-delay: 0.15s; }
    .reveal-delay-2 { transition-delay: 0.3s; }
    .reveal-delay-3 { transition-delay: 0.45s; }

    /* ─── DIVIDER ────────────────────────────────────────────────── */
    .divider { display: flex; align-items: center; gap: 20px; margin-bottom: 60px; }
    .divider-line {
      flex: 1; height: 1px;
      background: linear-gradient(to right, transparent, var(--khaki), transparent);
      opacity: 0.4;
    }
    .divider-icon { font-size: 1.2rem; color: var(--ember); line-height: 1; }

    /* ─── HERO ───────────────────────────────────────────────────── */
    #hero {
      height: 100vh; min-height: 700px;
      position: relative;
      display: flex; align-items: center; justify-content: center;
      overflow: hidden;
    }
    .hero-bg {
      position: absolute; inset: 0;
      background:
        linear-gradient(to bottom, rgba(14,31,20,0.55) 0%, rgba(14,31,20,0.72) 60%, rgba(14,31,20,0.96) 100%),
        url('https://images.unsplash.com/photo-1551632811-561732d1e306?auto=format&fit=crop&q=80&w=1920') center/cover no-repeat;
      transform: scale(1.06);
      transition: transform 8s ease-out;
    }
    #hero.loaded .hero-bg { transform: scale(1); }
    .hero-bg::after {
      content: '';
      position: absolute; inset: 0;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
      opacity: 0.35; pointer-events: none;
    }
    .hero-content { position: relative; text-align: center; color: var(--parchment); padding: 0 20px; }
    .hero-logo {
      width: 160px; margin-bottom: 30px;
      opacity: 0; transform: translateY(20px);
      animation: fadeUp 1s 0.3s ease forwards;
      filter: drop-shadow(0 4px 24px rgba(0,0,0,0.5));
    }
    .hero-eyebrow {
      font-family: 'Space Mono', monospace;
      font-size: 0.7rem; letter-spacing: 0.3em; text-transform: uppercase;
      color: var(--ember); opacity: 0;
      animation: fadeUp 1s 0.6s ease forwards;
      margin-bottom: 16px;
    }
    .hero-title {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: clamp(4rem, 10vw, 9rem);
      font-weight: 900; line-height: 0.92; letter-spacing: -0.02em;
      opacity: 0; animation: fadeUp 1s 0.8s ease forwards;
      text-shadow: 0 4px 40px rgba(0,0,0,0.4);
    }
    .hero-title em { font-style: italic; color: var(--khaki); }
    .hero-tagline {
      font-family: 'Cormorant Garamond', serif;
      font-size: clamp(1.1rem, 2.5vw, 1.55rem);
      font-style: italic; font-weight: 300; letter-spacing: 0.06em;
      color: rgba(242,237,228,0.78); margin-top: 20px;
      opacity: 0; animation: fadeUp 1s 1.1s ease forwards;
    }
    .hero-scroll {
      position: absolute; bottom: 40px; left: 50%; transform: translateX(-50%);
      display: flex; flex-direction: column; align-items: center; gap: 8px;
      opacity: 0; animation: fadeUp 1s 1.6s ease forwards;
      color: rgba(242,237,228,0.5);
      font-family: 'Space Mono', monospace;
      font-size: 0.6rem; letter-spacing: 0.2em; text-transform: uppercase;
    }
    .scroll-line {
      width: 1px; height: 50px;
      background: linear-gradient(to bottom, var(--ember), transparent);
      animation: scrollLine 2s ease infinite;
    }
    @keyframes scrollLine {
      0%   { transform: scaleY(0); transform-origin: top; }
      50%  { transform: scaleY(1); transform-origin: top; }
      51%  { transform: scaleY(1); transform-origin: bottom; }
      100% { transform: scaleY(0); transform-origin: bottom; }
    }

    /* ─── MARQUEE ─────────────────────────────────────────────────── */
    .gear-strip {
      background: var(--dusk); padding: 28px 0; overflow: hidden;
      border-top: 1px solid rgba(196,169,125,0.1);
      border-bottom: 1px solid rgba(196,169,125,0.1);
    }
    .marquee-track {
      display: flex; gap: 60px; width: max-content;
      animation: marquee 22s linear infinite; align-items: center;
    }
    .marquee-item {
      display: flex; align-items: center; gap: 18px;
      white-space: nowrap;
      font-family: 'Space Mono', monospace;
      font-size: 0.7rem; letter-spacing: 0.22em; text-transform: uppercase;
      color: rgba(196,169,125,0.5);
    }
    .marquee-dot { width: 5px; height: 5px; background: var(--ember); border-radius: 50%; flex-shrink: 0; }
    @keyframes marquee { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }

    /* ─── PHILOSOPHY ─────────────────────────────────────────────── */
    #philosophy { background: var(--dusk); padding: 140px 0; overflow: hidden; }
    #philosophy .section-inner { position: relative; }
    .philosophy-label {
      font-family: 'Space Mono', monospace;
      font-size: 0.68rem; letter-spacing: 0.3em; text-transform: uppercase;
      color: var(--ember); margin-bottom: 28px; display: block;
    }
    .philosophy-quote {
      font-family: 'Playfair Display', serif;
      font-size: clamp(2.2rem, 4.5vw, 4rem);
      font-style: italic; font-weight: 400; line-height: 1.25;
      color: var(--parchment); max-width: 820px; margin-bottom: 50px; position: relative;
    }
    .philosophy-quote::before {
      content: '\201C'; font-size: 10rem; color: var(--pine);
      position: absolute; top: -30px; left: -60px; line-height: 1;
      font-family: 'Playfair Display', serif; pointer-events: none;
    }
    .philosophy-body {
      font-size: 1.2rem; font-weight: 300;
      color: rgba(242,237,228,0.65); max-width: 620px; line-height: 1.9;
    }
    .philosophy-accent {
      position: absolute; right: 0; top: 50%; transform: translateY(-50%);
      width: 280px; height: 280px; border-radius: 50%;
      background: radial-gradient(circle, rgba(45,82,55,0.5), transparent 70%);
      pointer-events: none;
    }

    /* ─── ABOUT ──────────────────────────────────────────────────── */
    #about { background: var(--cream); padding: 140px 0; }
    .about-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: center; }
    .about-visual { position: relative; }
    .about-img-main {
      width: 100%; aspect-ratio: 4/5; object-fit: cover; border-radius: 4px;
      filter: brightness(0.92) saturate(1.1);
      box-shadow: 20px 20px 60px rgba(0,0,0,0.18);
    }
    .about-badge {
      position: absolute; bottom: -20px; right: -20px;
      width: 130px; height: 130px;
      background: var(--forest); border-radius: 50%;
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      box-shadow: 0 8px 32px rgba(0,0,0,0.25); border: 3px solid var(--khaki);
    }
    .about-badge-num { font-family: 'Playfair Display', serif; font-size: 2.2rem; font-weight: 900; color: var(--ember); line-height: 1; }
    .about-badge-text { font-family: 'Space Mono', monospace; font-size: 0.52rem; letter-spacing: 0.12em; color: var(--khaki); text-transform: uppercase; text-align: center; margin-top: 4px; }
    .about-text .section-label { font-family: 'Space Mono', monospace; font-size: 0.68rem; letter-spacing: 0.3em; text-transform: uppercase; color: var(--ember); margin-bottom: 20px; display: block; }
    .about-heading { font-family: 'Playfair Display', serif; font-size: clamp(2.4rem, 4vw, 3.4rem); font-weight: 700; line-height: 1.15; color: var(--forest); margin-bottom: 28px; }
    .about-heading em { font-style: italic; color: var(--sage); }
    .about-para { font-size: 1.18rem; line-height: 1.95; color: var(--text-mid); margin-bottom: 22px; }
    .about-stats { display: flex; gap: 40px; margin-top: 40px; padding-top: 36px; border-top: 1px solid rgba(0,0,0,0.08); }
    .stat-item { text-align: left; }
    .stat-num { font-family: 'Playfair Display', serif; font-size: 2.6rem; font-weight: 900; color: var(--forest); line-height: 1; }
    .stat-num span { color: var(--ember); }
    .stat-label { font-family: 'Space Mono', monospace; font-size: 0.6rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--text-mid); margin-top: 4px; }

    /* ─── MILESTONES ─────────────────────────────────────────────── */
    #milestones { background: var(--forest); padding: 140px 0; }
    .milestones-header { text-align: center; margin-bottom: 80px; }
    .milestones-header .section-label { font-family: 'Space Mono', monospace; font-size: 0.68rem; letter-spacing: 0.3em; text-transform: uppercase; color: var(--ember); margin-bottom: 18px; display: block; }
    .milestones-heading { font-family: 'Playfair Display', serif; font-size: clamp(2.5rem, 5vw, 4rem); font-weight: 900; color: var(--parchment); line-height: 1.1; }
    .milestones-heading em { font-style: italic; color: var(--khaki); }
    .cards-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2px; border: 2px solid rgba(196,169,125,0.15); border-radius: 8px; overflow: hidden; }
    .activity-card { background: rgba(255,255,255,0.03); padding: 50px 40px; border-right: 1px solid rgba(196,169,125,0.12); transition: background 0.4s; position: relative; overflow: hidden; }
    .activity-card:last-child { border-right: none; }
    .activity-card::before { content: ''; position: absolute; bottom: 0; left: 0; width: 100%; height: 3px; background: var(--ember); transform: scaleX(0); transform-origin: left; transition: transform 0.5s ease; }
    .activity-card:hover { background: rgba(255,255,255,0.06); }
    .activity-card:hover::before { transform: scaleX(1); }
    .card-icon { font-size: 2.8rem; margin-bottom: 24px; display: block; filter: grayscale(0.2); }
    .card-number { font-family: 'Space Mono', monospace; font-size: 0.62rem; letter-spacing: 0.25em; color: var(--ember); text-transform: uppercase; margin-bottom: 14px; display: block; }
    .card-title { font-family: 'Playfair Display', serif; font-size: 1.9rem; font-weight: 700; color: var(--parchment); margin-bottom: 18px; }
    .card-body { font-size: 1.08rem; line-height: 1.85; color: rgba(242,237,228,0.6); margin-bottom: 28px; }
    .card-achievement { display: inline-flex; align-items: center; gap: 10px; background: rgba(212,113,42,0.15); border: 1px solid rgba(212,113,42,0.3); border-radius: 40px; padding: 8px 18px; font-family: 'Space Mono', monospace; font-size: 0.62rem; letter-spacing: 0.1em; color: var(--ember-lt); text-transform: uppercase; }
    .card-achievement::before { content: '▲'; font-size: 0.5rem; }

    /* ─── JOURNAL ─────────────────────────────────────────────────── */
    #journal { background: var(--parchment); padding: 140px 0; }
    .journal-grid { display: grid; grid-template-columns: 1fr 2fr; gap: 100px; align-items: start; }
    .journal-sticky { position: sticky; top: 120px; }
    .journal-label { font-family: 'Space Mono', monospace; font-size: 0.68rem; letter-spacing: 0.3em; text-transform: uppercase; color: var(--ember); margin-bottom: 20px; display: block; }
    .journal-title { font-family: 'Playfair Display', serif; font-size: clamp(2.2rem, 3.5vw, 3rem); font-weight: 700; line-height: 1.2; color: var(--forest); margin-bottom: 24px; }
    .journal-intro { font-size: 1.1rem; line-height: 1.9; color: var(--text-mid); }
    .journal-entries { display: flex; flex-direction: column; gap: 0; }
    .journal-entry { padding: 44px 0; border-bottom: 1px solid rgba(0,0,0,0.08); display: grid; grid-template-columns: 80px 1fr; gap: 30px; align-items: start; }
    .journal-entry:first-child { padding-top: 0; }
    .entry-date { font-family: 'Space Mono', monospace; font-size: 0.6rem; letter-spacing: 0.12em; color: var(--ember); text-transform: uppercase; line-height: 1.6; padding-top: 6px; }
    .entry-title { font-family: 'Playfair Display', serif; font-size: 1.5rem; font-weight: 700; color: var(--forest); margin-bottom: 12px; }
    .entry-title a { color: inherit; text-decoration: none; transition: color 0.2s; }
    .entry-title a:hover { color: var(--ember); }
    .entry-text { font-size: 1.08rem; line-height: 1.9; color: var(--text-mid); }
    .entry-tag { display: inline-block; margin-top: 16px; background: var(--forest); color: var(--khaki); font-family: 'Space Mono', monospace; font-size: 0.58rem; letter-spacing: 0.14em; text-transform: uppercase; padding: 5px 14px; border-radius: 3px; }
    .journal-view-all { margin-top: 48px; display: inline-block; font-family: 'Space Mono', monospace; font-size: 0.68rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--ember); text-decoration: none; border-bottom: 1px solid rgba(212,113,42,0.4); padding-bottom: 3px; transition: border-color 0.2s; }
    .journal-view-all:hover { border-color: var(--ember); }

    /* ─── CONTACT ─────────────────────────────────────────────────── */
    #contact { background: var(--dusk); padding: 140px 0; position: relative; overflow: hidden; }
    #contact::before { content: ''; position: absolute; top: -200px; right: -200px; width: 600px; height: 600px; border-radius: 50%; background: radial-gradient(circle, rgba(45,82,55,0.35) 0%, transparent 70%); pointer-events: none; }
    .contact-grid { display: grid; grid-template-columns: 1fr 1.1fr; gap: 100px; align-items: start; }
    .contact-left .section-label { font-family: 'Space Mono', monospace; font-size: 0.68rem; letter-spacing: 0.3em; text-transform: uppercase; color: var(--ember); margin-bottom: 22px; display: block; }
    .contact-heading { font-family: 'Playfair Display', serif; font-size: clamp(2.4rem, 4vw, 3.6rem); font-weight: 700; line-height: 1.12; color: var(--parchment); margin-bottom: 28px; }
    .contact-heading em { font-style: italic; color: var(--khaki); }
    .contact-sub { font-size: 1.12rem; line-height: 1.9; color: rgba(242,237,228,0.55); margin-bottom: 50px; }
    .contact-items { display: flex; flex-direction: column; gap: 24px; }
    .contact-item { display: flex; align-items: center; gap: 18px; }
    .contact-icon { width: 48px; height: 48px; border-radius: 50%; background: rgba(255,255,255,0.05); border: 1px solid rgba(196,169,125,0.25); display: flex; align-items: center; justify-content: center; font-size: 1.2rem; flex-shrink: 0; }
    .contact-detail { font-family: 'Cormorant Garamond', serif; font-size: 1.1rem; color: rgba(242,237,228,0.7); }
    .contact-form { background: rgba(255,255,255,0.04); border: 1px solid rgba(196,169,125,0.15); border-radius: 8px; padding: 50px; }
    .form-group { margin-bottom: 24px; position: relative; }
    .form-label { font-family: 'Space Mono', monospace; font-size: 0.62rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--khaki); display: block; margin-bottom: 10px; }
    .form-input { width: 100%; padding: 16px 20px; background: rgba(255,255,255,0.04); border: 1px solid rgba(196,169,125,0.2); border-radius: 4px; color: var(--parchment); font-family: 'Cormorant Garamond', serif; font-size: 1.1rem; outline: none; transition: border-color 0.3s, background 0.3s; }
    .form-input::placeholder { color: rgba(242,237,228,0.25); }
    .form-input:focus { border-color: var(--ember); background: rgba(255,255,255,0.07); }
    textarea.form-input { resize: none; height: 140px; }
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
    .btn-submit { width: 100%; padding: 18px; background: var(--ember); color: var(--cream); border: none; border-radius: 4px; font-family: 'Space Mono', monospace; font-size: 0.75rem; letter-spacing: 0.22em; text-transform: uppercase; cursor: pointer; transition: background 0.3s, transform 0.2s; margin-top: 10px; }
    .btn-submit:hover { background: var(--ember-lt); transform: translateY(-2px); }
    .btn-submit:active { transform: translateY(0); }
    .form-success { display: none; text-align: center; padding: 20px; color: var(--sage); font-family: 'Playfair Display', serif; font-style: italic; font-size: 1.2rem; }

    /* ─── FOOTER ──────────────────────────────────────────────────── */
    footer { background: #050e08; padding: 60px; display: flex; flex-direction: column; align-items: center; gap: 24px; border-top: 1px solid rgba(196,169,125,0.1); }
    .footer-logo { height: 64px; opacity: 0.8; }
    .footer-tagline { font-family: 'Playfair Display', serif; font-style: italic; font-size: 1.1rem; color: rgba(196,169,125,0.6); }
    .footer-links { display: flex; gap: 40px; list-style: none; }
    .footer-links a { font-family: 'Space Mono', monospace; font-size: 0.62rem; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(242,237,228,0.35); text-decoration: none; transition: color 0.25s; }
    .footer-links a:hover { color: var(--ember); }
    .footer-copy { font-family: 'Space Mono', monospace; font-size: 0.58rem; letter-spacing: 0.12em; color: rgba(242,237,228,0.2); text-align: center; }

    /* ─── SINGLE POST ─────────────────────────────────────────────── */
    .post-hero-img { width: 100%; height: 480px; object-fit: cover; display: block; }
    .post-hero-placeholder { width: 100%; height: 480px; background: var(--dusk); display: flex; align-items: flex-end; }
    .post-wrapper { max-width: 780px; margin: 0 auto; padding: 80px 40px; }
    .post-stats-bar { display: flex; flex-wrap: wrap; gap: 20px; padding: 18px 24px; background: var(--forest); border-radius: 6px; margin-bottom: 48px; }
    .post-stat { font-family: 'Space Mono', monospace; font-size: 0.65rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--khaki); }
    .post-stat strong { color: var(--ember); display: block; font-size: 1rem; font-family: 'Playfair Display', serif; font-weight: 700; letter-spacing: 0; text-transform: none; }
    .post-body { font-size: 1.18rem; line-height: 1.95; color: var(--text-mid); }
    .post-body h2 { font-family: 'Playfair Display', serif; font-size: 2rem; font-weight: 700; color: var(--forest); margin: 2.5rem 0 1rem; }
    .post-body h3 { font-family: 'Playfair Display', serif; font-size: 1.5rem; font-weight: 700; color: var(--forest); margin: 2rem 0 0.75rem; }
    .post-body p { margin-bottom: 1.4rem; }
    .post-body blockquote { border-left: 3px solid var(--ember); padding: 1rem 1.5rem; margin: 2rem 0; font-style: italic; color: var(--text-mid); background: rgba(212,113,42,0.04); }
    .post-body img { width: 100%; border-radius: 4px; margin: 2rem 0; }
    .post-back { display: inline-block; font-family: 'Space Mono', monospace; font-size: 0.68rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ember); text-decoration: none; margin-top: 60px; border-bottom: 1px solid rgba(212,113,42,0.3); padding-bottom: 3px; }
    .post-back:hover { border-color: var(--ember); }

    /* ─── ARCHIVE PAGE ────────────────────────────────────────────── */
    .archive-header { background: var(--dusk); padding: 160px 60px 80px; }
    .archive-header h1 { font-family: 'Playfair Display', serif; font-size: clamp(2.5rem,6vw,5rem); font-weight: 900; color: var(--parchment); }
    .archive-header h1 em { color: var(--khaki); font-style: italic; }
    .archive-filter { display: flex; gap: 12px; margin-top: 32px; flex-wrap: wrap; }
    .filter-btn { font-family: 'Space Mono', monospace; font-size: 0.62rem; letter-spacing: 0.16em; text-transform: uppercase; padding: 8px 20px; border: 1px solid rgba(196,169,125,0.3); border-radius: 40px; color: rgba(242,237,228,0.55); cursor: pointer; background: transparent; text-decoration: none; transition: all 0.25s; }
    .filter-btn:hover, .filter-btn.active { background: var(--ember); border-color: var(--ember); color: var(--cream); }
    .archive-grid { max-width: 1200px; margin: 0 auto; padding: 80px 60px; display: grid; grid-template-columns: repeat(2, 1fr); gap: 40px; background: var(--parchment); }
    .archive-card { border-bottom: 1px solid rgba(0,0,0,0.08); padding-bottom: 40px; }
    .archive-card-meta { display: flex; gap: 16px; align-items: center; margin-bottom: 14px; }

    /* ─── KEYFRAMES ──────────────────────────────────────────────── */
    @keyframes fadeUp { to { opacity: 1; transform: translateY(0); } }

    /* ─── RESPONSIVE ─────────────────────────────────────────────── */
    @media (max-width: 900px) {
      nav { padding: 16px 24px; }
      nav.scrolled { padding: 12px 24px; }
      .nav-links { display: none; }
      .section-inner { padding: 0 24px; }
      .about-grid { grid-template-columns: 1fr; gap: 50px; }
      .cards-grid { grid-template-columns: 1fr; border: none; gap: 12px; }
      .activity-card { border: 1px solid rgba(196,169,125,0.15); border-radius: 6px; border-right: 1px solid rgba(196,169,125,0.15); }
      .journal-grid { grid-template-columns: 1fr; gap: 50px; }
      .journal-sticky { position: static; }
      .contact-grid { grid-template-columns: 1fr; gap: 50px; }
      .contact-form { padding: 30px 24px; }
      .form-row { grid-template-columns: 1fr; }
      footer { padding: 40px 24px; }
      .footer-links { flex-wrap: wrap; justify-content: center; gap: 20px; }
      .archive-grid { grid-template-columns: 1fr; padding: 40px 24px; }
      .archive-header { padding: 140px 24px 60px; }
      .post-wrapper { padding: 60px 24px; }
    }
  </style>
</head>
<body>

  <div class="cursor-dot" id="cursorDot"></div>
  <div class="cursor-ring" id="cursorRing"></div>

  <nav id="mainNav">
    <a href="/"><img src="/CheetahLogo.png" alt="Sloww Cheetah" class="nav-logo" /></a>
    <ul class="nav-links">
      <li><a href="/#philosophy">Philosophy</a></li>
      <li><a href="/#about">About</a></li>
      <li><a href="/#milestones">Milestones</a></li>
      <li><a href="/journal/">Journal</a></li>
      <li><a href="/#contact">Connect</a></li>
    </ul>
  </nav>

  {{ content | safe }}

  <footer>
    <img src="/CheetahLogo.png" alt="Sloww Cheetah" class="footer-logo" />
    <p class="footer-tagline">Chase Adventure, Not Speed.</p>
    <ul class="footer-links">
      <li><a href="/#philosophy">Philosophy</a></li>
      <li><a href="/#about">About</a></li>
      <li><a href="/journal/">Journal</a></li>
      <li><a href="https://www.instagram.com/sloww_cheetah/" target="_blank" rel="noopener">Instagram</a></li>
      <li><a href="https://www.youtube.com/@SlowwCheetah" target="_blank" rel="noopener">YouTube</a></li>
      <li><a href="/#contact">Connect</a></li>
    </ul>
    <p class="footer-copy">© {{ "" | date("yyyy") }} SLOWW CHEETAH · Vadodara, Gujarat · Chase Adventure, Not Speed.</p>
  </footer>

  <script>
    const dot  = document.getElementById('cursorDot');
    const ring = document.getElementById('cursorRing');
    let mx = 0, my = 0, rx = 0, ry = 0;
    document.addEventListener('mousemove', e => {
      mx = e.clientX; my = e.clientY;
      dot.style.left = mx + 'px'; dot.style.top = my + 'px';
    });
    (function animateRing() {
      rx += (mx - rx) * 0.12; ry += (my - ry) * 0.12;
      ring.style.left = rx + 'px'; ring.style.top = ry + 'px';
      requestAnimationFrame(animateRing);
    })();

    const nav = document.getElementById('mainNav');
    window.addEventListener('scroll', () => nav.classList.toggle('scrolled', window.scrollY > 60));

    window.addEventListener('load', () => {
      const hero = document.getElementById('hero');
      if (hero) hero.classList.add('loaded');
    });

    const revealEls = document.querySelectorAll('.reveal');
    const io = new IntersectionObserver((entries) => {
      entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); io.unobserve(e.target); } });
    }, { threshold: 0.12 });
    revealEls.forEach(el => io.observe(el));

    function handleSubmit() {
      const name    = document.getElementById('fname')?.value.trim();
      const email   = document.getElementById('femail')?.value.trim();
      const message = document.getElementById('fmessage')?.value.trim();
      if (!name || !email || !message) { alert('Please fill in all fields.'); return; }
      document.getElementById('submitBtn').style.display = 'none';
      document.getElementById('formSuccess').style.display = 'block';
    }

    if (window.netlifyIdentity) {
      window.netlifyIdentity.on('init', user => {
        if (!user) {
          window.netlifyIdentity.on('login', () => { document.location.href = '/admin/'; });
        }
      });
    }
  </script>
</body>
</html>
