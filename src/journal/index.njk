---
layout: base.njk
title: Journal
permalink: /journal/
---

<div class="archive-header">
  <span class="journal-label">Road &amp; Trail Journal</span>
  <h1 style="font-family:'Playfair Display',serif; font-size:clamp(2.5rem,6vw,5rem); font-weight:900; color:var(--parchment); line-height:1.05; margin-top:12px;">
    Stories from<br/><em style="color:var(--khaki);">the road</em>
  </h1>
  <div class="archive-filter">
    <a href="/journal/" class="filter-btn active" id="filter-all">All</a>
    <a href="/journal/cycling/" class="filter-btn">🚴 Cycling</a>
    <a href="/journal/running/" class="filter-btn">🏃 Running</a>
    <a href="/journal/trekking/" class="filter-btn">🥾 Trekking</a>
  </div>
</div>

<div style="background:var(--parchment); padding: 80px 60px; max-width: 1200px; margin: 0 auto;">
  {%- if collections.posts | length > 0 -%}
  <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 40px;">
    {%- for post in collections.posts -%}
    <article class="archive-card reveal">
      <div class="archive-card-meta">
        <span class="entry-tag">{{ post.data.category }}</span>
        <span style="font-family:'Space Mono',monospace; font-size:0.6rem; letter-spacing:0.12em; color:rgba(90,90,74,0.5); text-transform:uppercase;">
          {{ post.data.date | date("d MMM yyyy") }}
        </span>
      </div>
      <h2 style="font-family:'Playfair Display',serif; font-size:1.7rem; font-weight:700; color:var(--forest); margin-bottom:14px; line-height:1.2;">
        <a href="{{ post.url }}" style="color:inherit; text-decoration:none; transition:color 0.2s;" onmouseover="this.style.color='var(--ember)'" onmouseout="this.style.color='var(--forest)'">
          {{ post.data.title }}
        </a>
      </h2>
      <p style="font-size:1.05rem; line-height:1.85; color:var(--text-mid); margin-bottom:20px;">
        {{ post.data.description }}
      </p>
      {%- if post.data.distance or post.data.duration -%}
      <div style="display:flex; gap:20px; margin-bottom:16px;">
        {%- if post.data.distance -%}
        <span style="font-family:'Space Mono',monospace; font-size:0.6rem; letter-spacing:0.12em; text-transform:uppercase; color:var(--ember);">📏 {{ post.data.distance }}</span>
        {%- endif -%}
        {%- if post.data.duration -%}
        <span style="font-family:'Space Mono',monospace; font-size:0.6rem; letter-spacing:0.12em; text-transform:uppercase; color:var(--ember);">⏱ {{ post.data.duration }}</span>
        {%- endif -%}
        {%- if post.data.difficulty -%}
        <span style="font-family:'Space Mono',monospace; font-size:0.6rem; letter-spacing:0.12em; text-transform:uppercase; color:var(--ember);">● {{ post.data.difficulty }}</span>
        {%- endif -%}
      </div>
      {%- endif -%}
      <a href="{{ post.url }}" style="font-family:'Space Mono',monospace; font-size:0.65rem; letter-spacing:0.18em; text-transform:uppercase; color:var(--ember); text-decoration:none; border-bottom:1px solid rgba(212,113,42,0.3); padding-bottom:2px;">
        Read entry →
      </a>
    </article>
    {%- endfor -%}
  </div>
  {%- else -%}
  <div style="text-align:center; padding:120px 0;">
    <p style="font-family:'Playfair Display',serif; font-size:1.5rem; font-style:italic; color:var(--text-mid);">
      No entries yet. The road is waiting.
    </p>
    <p style="font-family:'Space Mono',monospace; font-size:0.7rem; letter-spacing:0.16em; color:rgba(90,90,74,0.5); margin-top:16px; text-transform:uppercase;">
      Publish your first post at <a href="/admin/" style="color:var(--ember);">/admin</a>
    </p>
  </div>
  {%- endif -%}
</div>

@media (max-width: 900px) {
  [style*="grid-template-columns: repeat(2"] { grid-template-columns: 1fr !important; }
}
